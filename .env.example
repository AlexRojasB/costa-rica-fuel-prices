# ─────────────────────────────────────────────────────────────
# costa-rica-fuel-prices — environment variables
#
# Copy: cp .env.example .env
# Fill in the values and never commit .env to git.
# ─────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────
# PostgreSQL (production / Docker)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/costa_rica_fuel

# SQLite (local dev without Docker)
# ConnectionStrings__DefaultConnection=Data Source=costa_rica_fuel.db

# ── Docker Compose ────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# ── CORS ──────────────────────────────────────────────────────
CORS_ORIGIN=*

# ─────────────────────────────────────────────────────────────
# DEPLOYMENT (Render / Railway) — set as env vars in the platform:
#
#   ConnectionStrings__DefaultConnection = postgresql://...
#   ASPNETCORE_ENVIRONMENT               = Production
#   Cors__AllowedOrigins__0              = https://your-domain.com
#
# PORT is injected automatically by the platform — do not set it.
# ─────────────────────────────────────────────────────────────
